<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.haruki.openclient</id>

  <name>bytecode</name>
  <summary>An OpenCode client</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="io.github.tsuchinaka">
    <name>tsuchinaka</name>
  </developer>

  <url type="homepage">https://github.com/tsuchinaka/bytecode</url>
  <url type="bugtracker">https://github.com/tsuchinaka/bytecode/issues</url>

  <description>
    <p>bytecode is a fast, native GTK4 client for the OpenCode AI coding agent server. It talks straight to the server's own API, so there is no bundled browser engine and no Node.js runtime.</p>
    <p>Features:</p>
    <ul>
      <li>Browse and manage sessions</li>
      <li>Chat with streaming responses</li>
      <li>View reasoning output</li>
      <li>Lightweight: built with Vala, GTK4 and Granite</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.haruki.openclient.desktop</launchable>

  <releases>
    <release version="0.1.0" date="2026-10-13"/>
  </releases>

  <content_rating type="oars-1.1"/>
</component>
