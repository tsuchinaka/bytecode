[Desktop Entry]
Version=1.0
Type=Application
Name=bytecode
GenericName=AI Coding Agent
Comment=An OpenCode client
Comment[es]=Un cliente de OpenCode
Exec=io.github.haruki.openclient
Icon=io.github.haruki.openclient
DBusActivatable=false
StartupNotify=true
StartupWMClass=io.github.haruki.openclient
Terminal=false
Categories=Development;IDE;
Keywords=AI;agent;bytecode;chat;code;LLM;opencode;
Keywords[es]=IA;agente;chat;codigo;
X-GNOME-UsesNotifications=true
Actions=NewSession;

[Desktop Action NewSession]
Name=New Session
Name[es]=Nueva sesión
Exec=io.github.haruki.openclient --new-session
